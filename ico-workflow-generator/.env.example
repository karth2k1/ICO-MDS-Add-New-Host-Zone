# Cisco Chat AI Credentials
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# OAuth credentials (from Cisco Developer Portal)
CISCO_CLIENT_ID=your_client_id_here
CISCO_CLIENT_SECRET=your_client_secret_here

# Chat AI App Key (required for Cisco Chat AI access)
CISCO_APPKEY=your_appkey_here
CISCO_USERNAME=your_cisco_username

# Optional: Override default URLs if needed
# CISCO_OAUTH_URL=https://id.cisco.com/oauth2/default/v1/token
# CISCO_CHAT_AI_URL=https://chat-ai.cisco.com/openai/deployments/gpt-4.1/chat/completions
