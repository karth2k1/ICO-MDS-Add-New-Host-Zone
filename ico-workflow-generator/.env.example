# Cisco Chat AI OAuth Credentials
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

CISCO_CLIENT_ID=your_client_id_here
CISCO_CLIENT_SECRET=your_client_secret_here

# Optional: Override default URLs if needed
# CISCO_OAUTH_URL=https://id.cisco.com/oauth2/default/v1/token
# CISCO_CHAT_AI_URL=https://chat-ai.cisco.com/openai/deployments/gpt-4.1/chat/completions
